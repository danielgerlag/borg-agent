{
  "id": "example.print-bench",
  "version": "0.1.0",
  "engines": {
    "borg": "^0.1.0"
  },
  "main": "@borg/example-print-bench/main",
  "ui": "@borg/example-print-bench/ui",
  "permissions": [
    "tools.register",
    "tools.invoke",
    "loops.start",
    "personas.read",
    "personas.write",
    "ui.workspace"
  ],
  "contributes": {
    "commands": [
      "example.print-bench.snapshot",
      "example.print-bench.act"
    ],
    "kinds": [
      "tool",
      "workspaceView"
    ]
  }
}
