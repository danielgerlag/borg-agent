{
  "name": "@borg/example-print-bench",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    "./borg.plugin.json": "./borg.plugin.json",
    "./main": "./dist/main.js",
    "./domain": "./dist/domain.js",
    "./ui": "./src/ui.tsx"
  },
  "borg": {
