  "dependencies": {
    "@borg-agent/contracts": "workspace:*",
    "@borg-agent/kernel": "workspace:*",
    "@borg-agent/plugin-sdk": "workspace:*",
    "@borg/plugin-anthropic": "workspace:*",
    "@borg/plugin-azure": "workspace:*",
    "@borg/plugin-config-sqlite": "workspace:*",
    "@borg/plugin-copilot": "workspace:*",
    "@borg/plugin-feedback": "workspace:*",
    "@borg/plugin-mock-llm": "workspace:*",
    "@borg/plugin-ollama": "workspace:*",
    "@borg/plugin-openai": "workspace:*",
    "@borg/plugin-openrouter": "workspace:*",
    "@borg/plugin-secrets-dev": "workspace:*",
    "@borg/plugin-security-prompt-injection": "workspace:*",
    "@borg/ui-kit": "workspace:*",
    "solid-js": "^1.9.15",
    "three": "^0.170.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p tsconfig.boot.json --noEmit"
  },
  "devDependencies": {
    "@types/three": "0.170.0"
