{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/test/**/*.ts",
    "apps/desktop/src/renderer/global.d.ts",
    "packages/**/test/**/*.ts",
    "plugins/**/test/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.mts"
  ]
}
